# TifoMaker server environment — copy to .env (never commit real secrets).
# Only DATABASE_URL is required in production; everything else has safe defaults.

# ---- core ----
DATABASE_URL=postgres://user:pass@localhost:5432/tifo   # required in production
PORT=8787
TRUST_PROXY=0                                           # set to 1 behind a reverse proxy/CDN (real client IP for rate limits + https in email links)
NODE_ENV=production
# DIST_DIR=                                              # path to built client (auto-detected if unset)
ADMIN_USERNAMES=                                         # comma-separated moderator usernames: existing accounts. A name with no account is reserved (claimed only by renaming to it in Account with the admin password).

# ---- email (verification + password reset) ----
# Default provider is Resend. With no RESEND_API_KEY the server logs the link to
# the console instead of sending (fine for local dev). For real email: create a
# Resend account, verify your sending domain, then set the key + From address.
RESEND_API_KEY=                                          # re_...  (keep secret)
EMAIL_FROM=TifoMaker <no-reply@tifomaker.org>            # must be on a domain you verified
PUBLIC_URL=https://tifomaker.org                         # base URL used in email links (no trailing slash)

# ---- AI text designer ----
# Claude first, Gemini behind it: with both keys set, Claude writes every design and
# Gemini takes over when Claude is busy, down or out of the month's API credit.
# AI_PROVIDER=gemini | anthropic | openai   (auto-detected from whichever key is set, Claude first)
ANTHROPIC_API_KEY=                                      # a key from the Claude Console (platform.claude.com → API keys)
# AI_CLAUDE_MODEL_FAST=claude-haiku-5-5                 # standard designs and the copywriter
# AI_CLAUDE_MODEL_PREMIUM=claude-sonnet-5-5             # Super AI, Polish, photo reading (claude-opus-5-5 = most capable, slower)
# AI_CLAUDE_EFFORT_PREMIUM=low                          # low | medium | high: more thought, longer wait (watch "Average wait" in /admin → AI)
# AI_CLAUDE_EFFORT_FAST=medium
# AI_CLAUDE_MAX_TOKENS=16000                            # output ceiling, thinking included (only what is written is billed)
# AI_PROVIDER_FALLBACK=                                 # "none" = no Gemini behind Claude
# AI_PROVIDER_COOLDOWN_MS=900000                        # after a refused key or spent credit, Claude is skipped this long (0 = never)
GEMINI_API_KEY=                                         # the backup; Google's free tier is enough
# GOOGLE_API_KEY=
OPENAI_API_KEY=
# AI_MODEL=
# AI_MODEL_PREMIUM=gemini-3.6-flash                     # Gemini: Super AI, Polish, photo reading (a retired id like gemini-3.5-flash is mapped to its replacement)
# AI_MODEL_FAST=gemini-3.1-flash-lite                   # Gemini: standard designs and the copywriter
# AI_MODEL_FALLBACK=gemini-3.5-flash-lite               # asked when a tier's model is busy, out of quota, timed out or retired; "none" = off (same-model retry)
# AI_MODEL_FALLBACK_PREMIUM=                            # per-tier override of AI_MODEL_FALLBACK
# AI_MODEL_FALLBACK_FAST=
# AI_TIMEOUT_MS=
AI_ADMIN_PASSWORD=                                       # unlocks AI while it's admin-gated
AI_FREE_LIMIT=10                                        # premium AI designs per account PER HOUR (Quick Designer is always free)
AI_FREE_FOR_ALL=true                                    # true = premium AI on for all verified accounts; false = premium off (everyone uses Quick Designer)
AI_DAILY_BUDGET=1000                                    # max premium model calls/day before the breaker routes everyone to Quick Designer (<=0 = unlimited); survives restarts
AI_DAILY_PICTURE_BUDGET=1000                            # max picture requests/day across everyone (failed tries included); when spent, designs arrive without a picture, reported as incomplete (<=0 = unlimited)

# ---- AI image (optional) ----
# Pollinations makes the pictures; Cloudflare Workers AI is the free backup (same FLUX
# model, about 170 pictures a day on any Cloudflare account). Gemini pictures have no
# free quota, so Gemini is the backup only when Cloudflare is not set up.
# AI_IMAGE_PROVIDER=                                    # pollinations (default) | cloudflare | gemini | none
# AI_IMAGE_FALLBACK=                                    # auto | cloudflare | gemini | a list (cloudflare,gemini) | none
# AI_CLOUDFLARE_ACCOUNT_ID=                             # 32 hex characters, from the Cloudflare dashboard
# AI_CLOUDFLARE_API_TOKEN=                              # a token with the "Workers AI" permission
# AI_CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# AI_CLOUDFLARE_STEPS=4                                 # 1-8; more steps, a little better and slower
# AI_IMAGE_MODEL=
# AI_IMAGE_TIMEOUT_MS=
# AI_POLLINATIONS_KEY=
# AI_POLLINATIONS_URL=
# AI_POLLINATIONS_MODEL=
