{
  "name": "tifo-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "tsx scripts/verify.mts",
    "verify:superai": "tsx scripts/verify-superai.mts",
    "export:sample": "tsx scripts/export-sample.mts",
    "templates:generate": "tsx scripts/generate-templates.mts",
    "templates:pack": "tsx scripts/pack-templates.mts",
    "test:templates": "node e2e-templates.mjs",
    "test:theme": "node e2e-theme.mjs",
    "server": "tsx server/src/server.ts",
    "server:watch": "tsx watch server/src/server.ts",
    "server:local": "node --env-file=.env --import tsx server/src/server.ts",
    "test:server": "tsx server/test/server.test.mts",
    "build:prod": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/src/server.ts",
