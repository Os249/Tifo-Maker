  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.1",
    "playwright": "^1.63.0",
