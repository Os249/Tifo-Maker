{
  "name": "tifo-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "tsx scripts/verify.mts",
    "verify:superai": "tsx scripts/verify-superai.mts",
    "export:sample": "tsx scripts/export-sample.mts",
    "server": "tsx server/src/server.ts",
    "server:watch": "tsx watch server/src/server.ts",
    "server:local": "node --env-file=.env --import tsx server/src/server.ts",
    "test:server": "tsx server/test/server.test.mts",
    "build:prod": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/src/server.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@tabler/icons-webfont": "^3.44.0",
    "fastify": "^5.9.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pixi.js": "^8.6.6",
    "qrcode": "^1.5.4",
    "three": "^0.185.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
