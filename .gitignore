# dependencies
node_modules/

# build output
dist/
out/
preview-out/

# environment / secrets: every variant (.env.production, .env.backup, .envrc),
# except the documented template
.env*
!.env.example
*.pem
*.key

# editor / OS
.DS_Store
*.log
.vscode/
.idea/

# temp
*.gif
/tmp/
# Vite writes this beside its config when a build is interrupted; one was committed.
vite.config.ts.timestamp-*
# Archives are how a whole folder (and whatever was in it) gets committed by accident.
*.zip

# local scratch: stitched aerial tiles, not redistributable
scratch-aerial/

# Hand-over files from an agent that could not push: a patch or a bundle is an
# INPUT you apply, never a change you commit. One of them got committed instead
# of applied once, and the fix it carried silently never reached the code.
*.patch
*.bundle

# written by the Docker build, read by /admin#security
audit-snapshot.json
