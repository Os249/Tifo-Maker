# Tifo Maker — environment configuration
# Copy to .env for local use, or set these in your host's dashboard.

# Postgres connection string. REQUIRED in production (NODE_ENV=production).
# Without it the server refuses to start in production; in development it
# falls back to an in-memory store (designs are lost on restart).
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Port the server listens on. Most hosts inject this automatically.
PORT=8787

# Set to "production" on your host. Enables the DATABASE_URL guard,
# rate limiting, and request logging.
NODE_ENV=production

# Optional: override the built-frontend directory if your layout differs.
# DIST_DIR=/app/dist

# ---- AI Tifo Designer ----
# Free AI generations granted per account before the quota blocks further runs.
AI_FREE_LIMIT=5

# The designer works fully offline (deterministic) with NO key set. To upgrade
# generation quality with a model, set ONE provider key below; the provider is
# auto-detected (or force it with AI_PROVIDER=anthropic|openai). The model is
# only ever asked for a TifoSpec (JSON), which is validated server-side; on any
# failure the offline designer is used, so the feature never hard-fails.
# Provider is Google Gemini (Phase 2). Set the key; the model defaults to
# gemini-2.5-flash, so AI_MODEL is optional.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash        # optional override (e.g. a -pro model)
# AI_TIMEOUT_MS=20000
# Local dev: put the vars above (uncommented, real values) in a .env file at the
# repo root, then run `npm run server:local` — it auto-loads .env. On Railway/host
# set them in the dashboard instead (never commit a real .env).
# Other providers also work (auto-detected from whichever key is set, or force
# with AI_PROVIDER): ANTHROPIC_API_KEY=  /  OPENAI_API_KEY=

# Admin lock for the AI Designer (Phase 1 of the AI rebuild). While AI is locked,
# generation is restricted to admins. Access is granted to a signed-in
# ADMIN_USERNAMES user, OR to anyone who enters this password in the editor's AI
# panel. The password lives ONLY here on the server — the browser only ever holds
# a signed, time-limited token (never the password). To change it: edit this value
# and restart the server (which invalidates all previously issued unlock tokens).
AI_ADMIN_PASSWORD=
