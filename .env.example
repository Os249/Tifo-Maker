# Tifo Maker — environment configuration
# Copy to .env for local use, or set these in your host's dashboard.

# Postgres connection string. REQUIRED in production (NODE_ENV=production).
# Without it the server refuses to start in production; in development it
# falls back to an in-memory store (designs are lost on restart).
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Port the server listens on. Most hosts inject this automatically.
PORT=8787

# Set to "production" on your host. Enables the DATABASE_URL guard,
# rate limiting, and request logging.
NODE_ENV=production

# Optional: override the built-frontend directory if your layout differs.
# DIST_DIR=/app/dist

# ---- AI Tifo Designer ----
# Free AI generations granted per account before the quota blocks further runs.
AI_FREE_LIMIT=5

# The designer works fully offline (deterministic) with NO key set. To upgrade
# generation quality with a model, set ONE provider key below; the provider is
# auto-detected (or force it with AI_PROVIDER=anthropic|openai). The model is
# only ever asked for a TifoSpec (JSON), which is validated server-side; on any
# failure the offline designer is used, so the feature never hard-fails.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest
# AI_TIMEOUT_MS=20000
