/**
 * Writes the stadium index (performance plan P2.7): the catalogue's grounds
 * without their geometry, and which module holds each ground's geometry.
 *
 *   npx tsx scripts/stadium-index.mts            write both files
 *   npx tsx scripts/stadium-index.mts --check    exit 1 if they are not what the catalogue makes now
 *
 * src/core/stadiumIndex.data.ts   id, tier and section counts and metadata of every catalogue
 *                                 ground, in catalogue order (core/stadiumIndex.ts)
 * src/core/stadiumGroups.data.ts  the ids each geometry module holds, legacy grounds
 *                                 included (core/stadiumLoad.ts)
 *
 * The catalogue (src/core/stadiumCatalog.ts and the league modules) stays the
 * only place a ground is written; these files are made from it, and
 * scripts/verify.mts fails when they are out of date. Run this after adding
 * or changing a ground. A ground missing from them still opens everywhere (it
 * is found through the full catalogue); it is only missing from the lists that
 * read the index.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
export const INDEX_PATH = join(ROOT, 'src/core/stadiumIndex.data.ts');
export const GROUPS_PATH = join(ROOT, 'src/core/stadiumGroups.data.ts');

const HEAD = [
  '// Generated by scripts/stadium-index.mts from the stadium catalogue. Do not edit:',
  '// change the ground in the catalogue, then run `npx tsx scripts/stadium-index.mts`.',
  '// scripts/verify.mts fails when this is out of date (performance plan P2.7).',
];

/** The two files' text, from the catalogue as it is now. */
export async function buildIndexFiles(): Promise<{ index: string; groups: string; grounds: number; ids: number }> {
  const cat = await import('../src/core/stadiumCatalog');
  const core = await import('../src/core/coreGrounds');
  const groups: [string, { id: string }[]][] = [
    ['core', [...core.BUILTINS_LIVE, ...core.COMMUNITY_LIVE, ...core.LEGACY_STADIUMS]],
    ['premier', (await import('../src/core/premierLeague')).PREMIER_LEAGUE],
    ['laliga', (await import('../src/core/laLiga')).LA_LIGA],
    ['ligue1', (await import('../src/core/ligue1')).LIGUE_1],
    ['superLig', (await import('../src/core/superLig')).SUPER_LIG],
    ['botola', (await import('../src/core/botola')).BOTOLA],
    ['algeria', (await import('../src/core/algeriaLigue1')).ALGERIA_LIGUE_1],
    ['thai', (await import('../src/core/thaiLeague')).THAI_LEAGUE],
  ];
  // Every shipped ground is in exactly one module, and every module's grounds are shipped.
  const shipped = new Set([...cat.STADIUM_CATALOG, ...cat.LEGACY_STADIUMS].map((e) => e.id));
  const seen = new Map<string, string>();
  for (const [g, list] of groups) {
    for (const e of list) {
      if (seen.has(e.id)) throw new Error(`stadium index: ${e.id} is in both ${seen.get(e.id)} and ${g}`);
      if (!shipped.has(e.id)) throw new Error(`stadium index: ${e.id} (${g}) is not in the catalogue`);
      seen.set(e.id, g);
    }
  }
  for (const id of shipped) if (!seen.has(id)) throw new Error(`stadium index: ${id} is in no geometry module`);

  const grounds = cat.STADIUM_CATALOG.filter((e) => e.meta.source !== 'custom' && !(e.meta.tags ?? []).includes('community-server'));
  const index = [
    ...HEAD,
    "import type { StadiumIndexEntry } from './stadiumIndex';",
    '',
    'export const INDEX_GROUNDS: readonly StadiumIndexEntry[] = [',
    ...grounds.map((e) => `  ${JSON.stringify({ id: e.id, tiers: cat.tierCount(e.template), sections: cat.sectionCount(e.template), meta: e.meta })},`),
    '];',
    '',
  ].join('\n');
  const groupsText = [
    ...HEAD,
    "import type { GroundGroup } from './stadiumLoad';",
    '',
    'export const GROUND_GROUPS: Readonly<Record<GroundGroup, readonly string[]>> = {',
    ...groups.map(([g, list]) => `  ${g}: ${JSON.stringify(list.map((e) => e.id))},`),
    '};',
    '',
  ].join('\n');
  return { index, groups: groupsText, grounds: grounds.length, ids: seen.size };
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const t0 = Date.now();
  const built = await buildIndexFiles();
  const took = ((Date.now() - t0) / 1000).toFixed(1);
  if (process.argv.includes('--check')) {
    const read = (p: string): string => { try { return readFileSync(p, 'utf8'); } catch { return ''; } };
    const stale = [[INDEX_PATH, built.index], [GROUPS_PATH, built.groups]].filter(([p, text]) => read(p) !== text).map(([p]) => p);
    if (stale.length) {
      console.error(`stadium index: ${stale.join(', ')} not what the catalogue makes now; run \`npx tsx scripts/stadium-index.mts\` and commit it`);
      process.exit(1);
    }
    console.log(`stadium index: up to date (${built.grounds} grounds, ${built.ids} ids, checked in ${took}s)`);
  } else {
    writeFileSync(INDEX_PATH, built.index);
    writeFileSync(GROUPS_PATH, built.groups);
    console.log(`stadium index: wrote ${built.grounds} grounds and ${built.ids} ids (${took}s)`);
  }
}
